// Parameters
int C1=99;int C2=98;real h=15; // W/m2.K

// Geometry
border C11 (t=0.,1.) {x=t;y=0.;label=C1;}
border C12 (t=0.,1.) {x=1.;y=t;label=C1;}
border C13 (t=0.,1.) {x=1.-t;y=1.;label=C1;}
border C14 (t=0.,1.) {x=0.;y=1.-t;label=C1;}
border B(t=0, 2*pi){x=0.5+0.3*cos(t); y=0.5+0.3*sin(t); label=C2;} // flue dimensions

// Mesh
mesh Th= buildmesh (C11(50)+C12(50)+C13(50)+C14(50)
	+B(-200));
	
plot (Th, wait=true);

// Definition of FE space
fespace Vh(Th,P1);
Vh u,v;

// EDP and boundary conditions
solve a(u,v)= int2d (Th) (
	dx(u)*dx(v)+dy(u)*dy(v)) // second derivative
	+ int1d(Th,C1) (h*u*v)
	- int1d(Th,C1)(h*25*v)	// Robin boundary condition
	+ on (C2, u=600); // Dirichlet boundary condition
	
// Results
plot (u,wait=true, value=true, fill=true);

ofstream out ("out.txt");

for (int i = 0; i < Th.nv ; ++i){
	out << Th(i).x << " " << Th(i).y<< " " << u[][i] << endl;
}


	