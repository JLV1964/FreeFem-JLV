// Parameters
real D=0.096,k1=50,k2=10*k1, diam=0.1, L=1,vel=25; // unidades de m,s
real Cinicial=0.10;

// Geometry
border a(t=0,L){x=t;y=0;label=1;};
border b(t=0,diam){x=L;y=t;label=2;};
border c(t=L,0){x=t;y=diam;label=3;};
border d(t=diam,0){x=0;y=t;label=4;};
int n=50;
mesh th=buildmesh(a(4*n)+b(n)+c(4*n)+d(n));
plot(th,wait=1);

// Definition of FE space
fespace Xh(th,P2);
fespace Mh(th,P2);
fespace Nh (th, P2);
Xh u1=Cinicial/5,v1;
Mh u2=0,v2;
Nh u3=0,v3;

// EDP and boundary conditions
solve pfr(u1,u2,u3,v1,v2,v3) =
	int2d(th)(
	D*(dx(u1)*dx(v1)+dy(u1)*dy(v1) // bilinear part
	+dx(u2)*dx(v2)+dy(u2)*dy(v2))
	+dx(u3)*dx(v3)+dy(u3)*dy(v3))
	+int2d(th)(vel*(v1*(dx(u1)+dy(u1))+v2*(dx(u2)+dy(u2))+v3*(dx(u3)+dy(u3))))
	- int2d(th) (-k1*u1*v1-k2*u2*v2+k1*u1*v2+k2*u2*v3)
	+on(4,u1=Cinicial,u2=0,u3=0);

// Results
plot(u1,fill=true,cmm= "CA",value=true,wait=1);
plot(u2,fill=true,cmm= "CB",value=true,wait=1);
plot(u3,fill=true,cmm= "CC",value=true,wait=1);

ofstream out ("pfr.txt");
real y0 = diam/2;real x0;
bool test;

for (int i= 0;i<th.nv;++i){
	x0=th(i).x;
	test=true;
	for (int j=0;j<i;++j) {
		if (x0==th(j).x) {test=false;}}
	if (test) {	out << x0 << " ," << u1(x0,y0) << " ," << u2(x0,y0) <<" ," << u3(x0,y0) <<endl;
				cout << x0 << " ," << u1(x0,y0) << " ," << u2(x0,y0) <<" ," << u3(x0,y0) <<endl;}}
